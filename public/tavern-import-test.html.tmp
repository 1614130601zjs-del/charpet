<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CharPet · 酒馆角色卡导入测试</title><style>*{box-sizing:border-box}body{margin:0;background:#f7f4ef;color:#302b28;font-family:system-ui,-apple-system,sans-serif}.wrap{width:min(900px,calc(100% - 28px));margin:auto;padding:32px 0 60px}.drop,.card,.panel{background:#fffdf9;border:1px solid #e3dbd3;border-radius:22px}.drop{display:block;padding:30px 18px;text-align:center;border:2px dashed #cfc3b9}.hidden{display:none}.result{margin-top:18px;display:grid;grid-template-columns:210px minmax(0,1fr);gap:16px}.card,.panel{padding:16px}.cover{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:15px}.timeline{border:1px solid #e2dad2;border-radius:16px;overflow:hidden;margin-top:11px}.timeline-head{display:flex;justify-content:space-between;align-items:center;padding:13px 14px;background:#faf7f3}.timeline-title{display:flex;align-items:center;gap:10px}.entry{display:grid;grid-template-columns:20px minmax(0,1fr);gap:10px;padding:12px 14px;border-top:1px solid #eee7df}.entry-text{margin-top:4px;line-height:1.6;white-space:pre-wrap}.empty{padding:16px;color:#8a817a;line-height:1.7}.field pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f5f0eb;padding:12px;border-radius:13px}@media(max-width:680px){.result{grid-template-columns:1fr}}input[type=checkbox]{cursor:pointer}</style></head><body><main class="wrap"><header><b>CHARPET · IMPORT LAB</b><h1>酒馆角色卡导入测试</h1><p>只从世界书词条标题识别年龄与人生时期，不读取正文来判断时间线。</p></header><label class="drop" id="drop"><strong>🪪 拖一张酒馆 PNG 角色卡到这里</strong><span>也可以点击选择文件 · 支持标准 chara / ccv3 PNG</span><input id="file" class="hidden" type="file" accept="image/png,.png"></label><div id="status"></div><div id="error"></div><section id="result"></section></main><script>const SIG=[137,80,78,71,13,10,26,10],MAX=20*1024*1024,$=id=>document.getElementById(id);const ascii=b=>new TextDecoder('latin1').decode(b),text=b=>new TextDecoder('utf-8').decode(b),u32=(b,o)=>new DataView(b.buffer,b.byteOffset+o,4).getUint32(0);function b64(v){const s=atob(v.replace(/\s+/g,'')),b=new Uint8Array(s.length);for(let i=0;i<s.length;i++)b[i]=s.charCodeAt(i);return b}function payload(v){try{const x=JSON.parse(text(b64(v)));return x&&typeof x==='object'?x:null}catch{return null}}function normalize(p,spec){const d=p.data&&typeof p.data==='object'?p.data:p;return{format:'png',spec,name:d.name||'',description:d.description||'',personality:d.personality||'',scenario:d.scenario||'',firstMessage:d.first_mes||'',messageExamples:d.mes_example||'',tags:Array.isArray(d.tags)?d.tags.filter(x=>typeof x==='string'):[],characterBook:d.character_book&&typeof d.character_book==='object'?d.character_book:null}}function parse(buf){const b=new Uint8Array(buf);if(b.length>MAX)throw Error('角色卡超过 20MB');if(b.length<8||!SIG.every((x,i)=>b[i]===x))throw Error('这不是 PNG 文件');let o=8,v3=null,v2=null,v1=null;while(o+12<=b.length){const len=u32(b,o),type=ascii(b.subarray(o+4,o+8)),ds=o+8,de=ds+len;if(de+4>b.length)break;const d=b.subarray(ds,de);if(type==='tEXt'){const z=d.indexOf(0);if(z>=0){const k=ascii(d.subarray(0,z)),v=ascii(d.subarray(z+1));if(k==='ccv3')v3=payload(v);if(k==='chara'){const q=payload(v);if(q){if(q.data&&typeof q.data==='object')v2=q;else v1=q}}}}o=de+4;if(type==='IEND')break}if(v3)return normalize(v3,'v3');if(v2)return normalize(v2,'v2');if(v1)return normalize(v1,'v1');throw Error('没有找到 chara / ccv3 角色卡数据')}function titleOf(e){return[e?.comment,e?.name,e?.key].find(v=>typeof v==='string'&&v.trim())?.trim()||''}function timeMarkFromTitle(e){const s=titleOf(e).replace(/[【】\[\]]/g,' ').replace(/\s+/g,' ').trim();const range=s.match(/(?:^|[\s·_—:：])(?:约)?(\d{1,3})\s*[~～\-—至到]\s*(\d{1,3})\s*(?:岁|周岁)(?:$|[\s·_—:：])/);if(range)return`${range[1]}-${range[2]}岁`;const age=s.match(/(?:^|[\s·_—:：])(?:约)?(\d{1,3})\s*(?:岁|周岁)(?:$|[\s·_—:：])/);if(age)return`${age[1]}岁`;const stages=['幼儿园','小学','初中','高中','大学','研究生','职高','职专','大专','本科','硕士','博士','职场','工作期','退休','童年','少年','青年','成年','成长期','学生时期','学生时代','毕业后','成年后','工作后','入职后'];for(const stage of stages)if(s.includes(stage))return stage.replace(/期$|时期$|时代$/,'');if(/男高/.test(s))return'男高';return null}function isExcluded(e){const t=titleOf(e);return/(npc|npcs|住址|地址|地点|房间|场所|状态栏|状态值|status|输出格式|格式要求|输出规则|system|系统提示|世界观设定|背景设定|装备|物品栏|inventory|关系网|其他角色资料|路人资料)/i.test(t)}function content(e){for(const k of ['content','entry','text','description','memo','value'])if(typeof e?.[k]==='string'&&e[k].trim())return e[k].trim();return''}function groupEntries(wb){const es=Array.isArray(wb?.entries)?wb.entries:[],groups=new Map();es.forEach((e,i)=>{e.__charpetIndex=i;const mark=timeMarkFromTitle(e);if(!mark||isExcluded(e))return;if(!groups.has(mark))groups.set(mark,[]);groups.get(mark).push(e)});return groups}function esc(s){return String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\\':'&#39;'}[c]||c))}function renderGroups(wb){const groups=groupEntries(wb);if(!groups.size)return'<div class="empty">暂时没有识别到时间线。<br>这里只检查世界书<strong>词条标题</strong>中的年龄或人生时期；正文完全不参与时间线识别。</div>';return[...groups.entries()].map(([timeline,es])=>{const all=es.every(e=>e.enabled!==false),none=es.every(e=>e.enabled===false),state=all?'全部开启':none?'全部关闭':'部分开启';return`<section class="timeline"><label class="timeline-head"><span class="timeline-title"><input class="timeline-switch" data-timeline="${esc(timeline)}" type="checkbox" ${all?'checked':''}><span><b>${esc(timeline)}</b><small>${es.length} 条相关词条</small></span></span><span>${state}</span></label>${es.map(e=>`<article class="entry"><input class="entry-switch" type="checkbox" data-entry="${e.__charpetIndex}" ${e.enabled!==false?'checked':''}><div><b>${esc(titleOf(e))}</b><div class="entry-text">${esc(content(e)||'（空）')}</div></div></article>`).join('')}</section>`}).join('')}function render(file,c){const reader=new FileReader();reader.onload=()=>{$('result').innerHTML=`<div class="result"><aside class="card"><img class="cover" src="${reader.result}" alt="角色卡"><div class="name">${esc(c.name||file.name)}</div></aside><div class="panel"><div class="field"><b>角色资料</b><pre>${esc([c.description,c.personality,c.scenario,c.firstMessage,c.messageExamples].filter(Boolean).join('\n\n')||'（空）')}</pre></div><section><h2>角色关联信息</h2><p>时间线<strong>只检测世界书词条标题</strong>。标题里有年龄、年龄范围或人生时期才建立时间线；正文不参与判断。</p><div id="periods">${renderGroups(c.characterBook)}</div></section></div></div>`;bindGroups(c)};reader.readAsDataURL(file)}function bindGroups(c){const groups=groupEntries(c.characterBook);document.querySelectorAll('.timeline-switch').forEach(sw=>{const arr=groups.get(sw.dataset.timeline)||[];sw.indeterminate=arr.some(e=>e.enabled!==false)&&arr.some(e=>e.enabled===false);sw.onchange=()=>{arr.forEach(e=>e.enabled=sw.checked);renderGroupsOnly(c)}});document.querySelectorAll('.entry-switch').forEach(sw=>{const e=(c.characterBook?.entries||[])[Number(sw.dataset.entry)];if(e)sw.onchange=ev=>{e.enabled=ev.target.checked;renderGroupsOnly(c)}})}function renderGroupsOnly(c){$('periods').innerHTML=renderGroups(c.characterBook);bindGroups(c)}async function handle(f){$('status').innerHTML='';$('error').innerHTML='';$('result').innerHTML='';if(!f)return;try{$('status').innerHTML='<div class="notice success">正在本地解析：'+esc(f.name)+'</div>';const c=parse(await f.arrayBuffer());render(f,c);$('status').innerHTML='<div class="notice success">✓ 解析成功：'+esc(c.name||f.name)+' · '+c.spec.toUpperCase()+'</div>'}catch(e){$('error').innerHTML='<div class="notice error">解析失败：'+esc(e.message||e)+'</div>'}}$('file').addEventListener('change',e=>handle(e.target.files?.[0]));$('drop').addEventListener('dragover',e=>e.preventDefault());$('drop').addEventListener('drop',e=>{e.preventDefault();handle(e.dataTransfer.files?.[0])});</script></body></html>